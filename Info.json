{
  "name": "Danmaku Cosmos",
  "identifier": "com.danmaku-cosmos.iina-plugin",
  "version": "4.5",
  "description": "IINA danmaku plugin with local files, Dandanplay network matching, and CSS/Canvas rendering",
  "author": {
    "name": "karappo-yu"
  },
  "entry": "main.js",
  "permissions": [
    "show-osd",
    "video-overlay",
    "network-request",
    "file-system"
  ],
  "sidebarTab": {
    "name": "Danmaku"
  },
  "allowedDomains": ["api.dandanplay.net", "*.dandanplay.net"],
  "preferenceDefaults": {
    "danmakuEnabled": true,
    "danmakuCanvasOpacity": 0.8,
    "niconicommentsFontScale": 1.0,
    "canvasMode": "css",
    "strokeColor": "#000000",
    "strokeInversionColor": "#ffffff",
    "strokeOpacity": 0.4,
    "strokeWidth": 2.8,
    "commentLimit": 0,
    "scrollSpeed": 1.0,
    "danmakuFontFamily": "",
    "danmakuFontWeight": "400",
    "dandanplayAppId": "",
    "dandanplayAppSecret": "",
    "dandanplayAutoNetwork": true,
    "dandanplayChConvert": 0,
    "dandanplayWithRelated": true,
    "danmakuForceSimplified": false,
    "danmakuAutoOffset": true
  }
}
