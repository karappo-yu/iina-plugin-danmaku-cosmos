{
  "name": "Danmaku Cosmos",
  "identifier": "com.danmaku-cosmos.iina-plugin",
  "version": "4.8",
  "description": "IINA danmaku plugin with local files, Dandanplay network matching, and CSS/Canvas rendering",
  "author": {
    "name": "karappo-yu"
  },
  "entry": "main.js",
  "permissions": [
    "show-osd",
    "video-overlay",
    "network-request",
    "file-system"
  ],
  "sidebarTab": {
    "name": "Danmaku"
  },
  "allowedDomains": [
    "api.dandanplay.net",
    "*.dandanplay.net"
  ],
  "preferenceDefaults": {
    "danmakuEnabled": true,
    "danmakuCanvasOpacity": 0.8,
    "niconicommentsFontScale": 1.0,
    "canvasMode": "css",
    "strokeColor": "#000000",
    "strokeInversionColor": "#ffffff",
    "strokeOpacity": 1,
    "strokeWidth": 0,
    "cssTextShadowBlur": 2,
    "commentLimit": 0,
    "danmakuFilterDensity": 0,
    "scrollSpeed": 1.0,
    "danmakuFontFamily": "",
    "danmakuFontWeight": "500",
    "stylePreset": "nico",
    "dandanplayAppId": "",
    "dandanplayAppSecret": "",
    "dandanplayAutoNetwork": true,
    "danmakuForceSimplified": false,
    "danmakuAutoOffset": false,
    "danmakuBlocklistEnabled": false,
    "danmakuBlocklist": "[]",
    "danmakuBlockTopEnabled": false,
    "danmakuBlockBottomEnabled": false,
    "danmakuDedupeEnabled": false,
    "danmakuDedupeWindow": 2,
    "danmakuBrowserVisible": true
  }
}
