{
  "name": "Danmaku Cosmos",
  "identifier": "com.danmaku-cosmos.iina-plugin",
  "version": "3.5",
  "description": "IINA弹幕插件 (niconicocomments-only渲染)",
  "author": {
    "name": "karappo-yu"
  },
  "entry": "main.js",
  "globalEntry": "global.js",
  "permissions": [
    "show-osd",
    "show-alert",
    "video-overlay",
    "network-request",
    "file-system"
  ],
  "sidebarTab": {
    "name": "Danmaku"
  },
  "allowedDomains": ["api.dandanplay.net", "*.dandanplay.net"],
  "preferenceDefaults": {
    "danmakuEnabled": true,
    "danmakuCanvasOpacity": 0.8,
    "niconicommentsFontScale": 1.0,
    "canvasMode": "default",
    "strokeColor": "#000000",
    "strokeInversionColor": "#ffffff",
    "strokeOpacity": 0.4,
    "strokeWidth": 2.8,
    "commentLimit": 0,
    "scrollSpeed": 0.95,
    "dandanplayAppId": "",
    "dandanplayAppSecret": "",
    "dandanplayAutoNetwork": true,
    "dandanplayChConvert": 0,
    "dandanplayWithRelated": true
  }
}
